                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "id": "c-when",
              "leftValue": "={{ DateTime.fromISO(String($json.body.appointmentAt ?? '')).isValid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
