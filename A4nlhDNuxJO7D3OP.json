      "position": [
        448,
        80
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "m-phone",
              "name": "phone",
              "type": "string",
              "value": "={{ $('Reminder request').item.json.body.phone }}"
            },
            {
              "id": "m-note",
              "name": "note",
              "type": "string",
              "value": "={{ String($('Reminder request').item.json.body.note ?? '').trim() }}"
            },
