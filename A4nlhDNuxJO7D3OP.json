      "position": [
        224,
        176
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'accepted', reviewed: !!String($json.body.note ?? '').trim(), executionId: $execution.id }) }}",
        "options": {
          "responseCode": 202
        }
      },
      "id": "1177cb23-5879-4d37-badc-bba6136720b7",
