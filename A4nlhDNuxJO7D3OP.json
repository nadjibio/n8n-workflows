              "id": "m-text",
              "name": "message",
              "type": "string",
              "value": "={{ 'Hi ' + $('Reminder request').item.json.body.patientName + ', a reminder of your appointment at ' + $('Reminder request').item.json.body.clinic + ' on ' + DateTime.fromISO($('Reminder request').item.json.body.appointmentAt).toFormat('cccc d LLL, HH:mm') + '.' + (String($('Reminder request').item.json.body.note ?? '').trim() ? ' ' + String($('Reminder request').item.json.body.note).trim() : '') }}"
            }
          ]
        },
        "options": {}
